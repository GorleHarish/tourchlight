# ============================================================
# RLM GBNF Grammar — Production-Ready v2.2
#
# BUG FIXES (15 total):
#  [1] CRITICAL  root: single-action → multi-step (step+)
#  [2] CRITICAL  file/code/query/answer content: any-char* → char-exclusion
#  [3] REMOVED   reasoning rule — see [13] below
#  [4] HIGH      bool-val: null separated into null-val
#  [5] HIGH      number-val: scientific notation added
#  [6] MEDIUM    tool-call-json: both key orderings accepted
#  [7] MEDIUM    root: trailing ws added
#  [8] MEDIUM    unbounded wildcards removed; bounded char classes used
#  [9] MEDIUM    error-tag added for tool failure / retry signaling
# [10] LOW       number-val: leading zeros rejected (RFC 8259)
# [11] LOW       string-val: explicit escape enumeration + \uXXXX validated
# [12] CRITICAL  all multi-line rules flattened to single-line alternatives.
#                The TurboQuant llama.cpp fork's GBNF parser does NOT accept a
#                rule whose continuation line STARTS with '|'. Single-line
#                alternatives are semantically identical and parse cleanly.
# [13] CRITICAL  reasoning rule DELETED. [^<\x00]+ accepted ANY prose except
#                '<', which masked EOS tokens (<|im_end|>, </s> all contain
#                '<'), so prose answers could never hit finish_reason: stop and
#                instead burned the full token budget. Bounded variants
#                (e.g. {0,120}) also failed live: the 2B model emitted prose
#                then a whitespace-filled <tool_call> with no JSON payload and
#                hit the length limit. Reasoning now lives in
#                implementation_plan.md (the prompt already mandates this).
# [14] CRITICAL  root: step+ → single step. 'step+' forced a SECOND action
#                after every valid tool call, so generation continued past a
#                complete call and rambled into the next step.
# [15] HIGH      tool-name-val / tool-name-str: added SET_PHASE,
#                PLAY_AND_VERIFY_GAME, SELF_IMPROVE_GAME to match the
#                registry — previously advertised but token-blocked.
#
# Agent pattern:  action ws  trailing-ws?
# One action per response; chains are driven by the engine loop, not the
# grammar. A complete action tag terminates generation (with the matching
# stop token), keeping every response parseable and bounded.
# ============================================================


# -----------------------------------------------
# ROOT — single action per response             [FIX 1, 7, 14]
# Exactly one structured action block. Final trailing ws
# accommodates models that append \n. Multi-step chains are
# driven by the engine loop (each response = one action), NOT
# by the grammar — this guarantees a valid call always
# terminates and is never followed by rambling prose.
# -----------------------------------------------
root ::= action ws

# -----------------------------------------------
# ACTION — exactly one structured output block
# -----------------------------------------------
action ::= tool-call-tag | tool-xml-tag | write-file-tag | code-tag | subquery-tag | error-tag | final-tag


# -----------------------------------------------
# 1. <tool_call> JSON </tool_call>             [FIX 6]
#
# Accepts BOTH key orderings:
#   {"name": "X", "arguments": {...}}
#   {"arguments": {...}, "name": "X"}
# This matches RFC 8259 §4 (key order is irrelevant).
# -----------------------------------------------
tool-call-tag  ::= "<tool_call>" ws tool-call-json ws "</tool_call>"
tool-call-json ::= "{" ws ( tool-kv-name-first | tool-kv-args-first ) ws "}"
tool-kv-name-first ::= "\"name\"" ws ":" ws tool-name-val ws "," ws "\"arguments\"" ws ":" ws tool-args-obj
tool-kv-args-first ::= "\"arguments\"" ws ":" ws tool-args-obj ws "," ws "\"name\"" ws ":" ws tool-name-val
tool-name-val ::= "\"WRITE_FILE\"" | "\"EDIT_FILE\"" | "\"READ_FILE\"" | "\"READ_SYMBOLS\"" | "\"SEARCH_AST\"" | "\"LIST_DIR\"" | "\"GREP\"" | "\"RUN_COMMAND\"" | "\"INSPECT_WEB\"" | "\"UPDATE_TASK_GRAPH\"" | "\"SAVE_MEMORY\"" | "\"WEB_SEARCH\"" | "\"WEB_FETCH\"" | "\"DOC_SEARCH\"" | "\"WEB_VERIFY\"" | "\"GIT\"" | "\"FORMAT_CODE\"" | "\"VERIFY\"" | "\"ASK_USER\"" | "\"SET_PHASE\"" | "\"PLAY_AND_VERIFY_GAME\"" | "\"SELF_IMPROVE_GAME\""


# -----------------------------------------------
# 2. <TOOL name="TOOL_NAME"> {...} </TOOL>
# -----------------------------------------------
tool-xml-tag  ::= "<TOOL name=\"" tool-name-str "\">" ws tool-args-obj ws "</TOOL>"
tool-name-str ::= "WRITE_FILE" | "EDIT_FILE" | "READ_FILE" | "READ_SYMBOLS" | "SEARCH_AST" | "LIST_DIR" | "GREP" | "RUN_COMMAND" | "INSPECT_WEB" | "UPDATE_TASK_GRAPH" | "SAVE_MEMORY" | "WEB_SEARCH" | "WEB_FETCH" | "DOC_SEARCH" | "WEB_VERIFY" | "GIT" | "FORMAT_CODE" | "VERIFY" | "ASK_USER" | "SET_PHASE" | "PLAY_AND_VERIFY_GAME" | "SELF_IMPROVE_GAME"


# -----------------------------------------------
# 3. <WRITE_FILE path="..."> content </WRITE_FILE>  [FIX 2, 8]
#
# write-file-unit: matches any single character or short sequence that is
# NOT the exact string </WRITE_FILE>. Each alternative is a valid prefix of
# the closing tag that diverges before completing it.
#
# DESIGN NOTE: For files whose content might literally contain the string
# "</WRITE_FILE>" (e.g., template files), use tool-call-tag with a JSON
# string "content" argument instead — JSON escaping handles all edge cases.
# -----------------------------------------------
write-file-tag     ::= "<WRITE_FILE path=\"" file-path-val "\">" write-file-content "</WRITE_FILE>"
file-path-val      ::= [^"\r\n\x00]+
write-file-content ::= write-file-unit*
write-file-unit    ::= [^<\x00] | "<" [^/\x00] | "</" [^W\x00] | "</W" [^R\x00] | "</WR" [^I\x00] | "</WRI" [^T\x00] | "</WRIT" [^E\x00] | "</WRITE" [^_\x00] | "</WRITE_" [^F\x00] | "</WRITE_F" [^I\x00] | "</WRITE_FI" [^L\x00] | "</WRITE_FIL" [^E\x00] | "</WRITE_FILE" [^>\x00]


# -----------------------------------------------
# 4. <CODE> ... </CODE>                        [FIX 2, 8]
# -----------------------------------------------
code-tag     ::= "<CODE>" code-content "</CODE>"
code-content ::= code-unit*
code-unit    ::= [^<\x00] | "<" [^/\x00] | "</" [^C\x00] | "</C" [^O\x00] | "</CO" [^D\x00] | "</COD" [^E\x00] | "</CODE" [^>\x00]


# -----------------------------------------------
# 5. <SUB_QUERY> ... </SUB_QUERY>              [FIX 2, 8]
# -----------------------------------------------
subquery-tag  ::= "<SUB_QUERY>" query-content "</SUB_QUERY>"
query-content ::= query-unit*
query-unit    ::= [^<\x00] | "<" [^/\x00] | "</" [^S\x00] | "</S" [^U\x00] | "</SU" [^B\x00] | "</SUB" [^_\x00] | "</SUB_" [^Q\x00] | "</SUB_Q" [^U\x00] | "</SUB_QU" [^E\x00] | "</SUB_QUE" [^R\x00] | "</SUB_QUER" [^Y\x00] | "</SUB_QUERY" [^>\x00]


# -----------------------------------------------
# 6. <ERROR> ... </ERROR>   [NEW — FIX 9]
#
# Emitted when a tool call fails or the agent needs to signal a retry.
# The agent parser should detect this tag and route to RecoveryEngine.
# error-content is intentionally simple (no nested tags expected).
# -----------------------------------------------
error-tag     ::= "<ERROR>" error-content "</ERROR>"
error-content ::= error-unit*
error-unit    ::= [^<\x00] | "<" [^/\x00] | "</" [^E\x00] | "</E" [^R\x00] | "</ER" [^R\x00] | "</ERR" [^O\x00] | "</ERRO" [^R\x00] | "</ERROR" [^>\x00]


# -----------------------------------------------
# 7. <FINAL_ANSWER> ... </FINAL_ANSWER>        [FIX 2, 8]
# -----------------------------------------------
final-tag      ::= "<FINAL_ANSWER>" answer-content "</FINAL_ANSWER>"
answer-content ::= answer-unit*
answer-unit    ::= [^<\x00] | "<" [^/\x00] | "</" [^F\x00] | "</F" [^I\x00] | "</FI" [^N\x00] | "</FIN" [^A\x00] | "</FINA" [^L\x00] | "</FINAL" [^_\x00] | "</FINAL_" [^A\x00] | "</FINAL_A" [^N\x00] | "</FINAL_AN" [^S\x00] | "</FINAL_ANS" [^W\x00] | "</FINAL_ANSW" [^E\x00] | "</FINAL_ANSWE" [^R\x00] | "</FINAL_ANSWER" [^>\x00]


# -----------------------------------------------
# JSON — RFC 8259 compliant
# -----------------------------------------------
tool-args-obj ::= "{" ws ( json-pair ( ws "," ws json-pair )* )? ws "}"
json-pair     ::= string-val ws ":" ws json-val

# [FIX 4] null-val is a distinct type, no longer grouped under bool-val
json-val      ::= string-val | number-val | bool-val | null-val | tool-args-obj | json-array

json-array    ::= "[" ws ( json-val ( ws "," ws json-val )* )? ws "]"


# [FIX 11] String: explicit escape enumeration; \uXXXX validated as 4 hex digits
string-val  ::= "\"" string-char* "\""
string-char ::= [^"\\\x00-\x1f] | "\\" ( "\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" ) | "\\u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]


# [FIX 5, 10] Number: scientific notation; leading zeros rejected
# Matches: -1, 0, 42, 3.14, 1e10, -2.5e-3, 1.5E+3
number-val ::= "-"? ( "0" | [1-9] [0-9]* ) ( "." [0-9]+ )? ( [eE] ( "+" | "-" )? [0-9]+ )?


# [FIX 4] Boolean and null are separate types
bool-val ::= "true" | "false"
null-val  ::= "null"


# Whitespace: zero or more spaces/tabs/newlines
ws ::= [ \t\n\r]*
