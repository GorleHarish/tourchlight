/* ═══════════════════════════════════════════════════════════════════════════
   Torchlight TUI — Main Stylesheet
   All colors reference theme variables. Zero hardcoded #hex values.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Base ──────────────────────────────────────────────────────────────── */

Screen {
    background: $background;
    color: $foreground;
}

Static {
    color: $foreground;
}

Label {
    color: $foreground;
}

/* ── Header & Footer ──────────────────────────────────────────────────── */

Header {
    background: $surface;
    color: $foreground;
    dock: top;
    height: 1;
}

Footer {
    background: $surface;
    color: $foreground;
}

/* ── Body Layout ──────────────────────────────────────────────────────── */

/* ── VS Code / Antigravity Style Multi-Tab Split Layout ───────────────── */

#main-ide-container {
    height: 1fr;
    width: 1fr;
}

#explorer-sidebar {
    width: 24;
    height: 100%;
    background: $surface;
    border-right: heavy $primary;
    padding: 0 0;
}

#plan-sidebar {
    width: 30;
    height: 100%;
    background: $surface;
    border-left: heavy $primary;
    padding: 0 0;
}

/* ═══════════════════════════════════════════════════════════════════════
    PHASE 5 — Tabbed editor split pane (implemented).
    ═══════════════════════════════════════════════════════════════════════ */

#editor-split-pane {
    display: none;
    width: 3fr;
    height: 100%;
    border-right: heavy $primary;
    background: $background;
}

#tab-bar-header {
    height: 1;
    background: $panel;
    border-bottom: solid $primary;
}

#tab-buttons-container {
    width: 1fr;
    height: 1;
    overflow-x: auto;
}

.tab-item-active {
    height: 1;
    width: auto;
    background: $surface;
    border-bottom: solid $primary;
    margin-right: 1;
}

.tab-item-inactive {
    height: 1;
    width: auto;
    background: $panel;
    margin-right: 1;
}

.tab-label-btn {
    height: 1;
    min-width: 6;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $primary;
    text-style: bold;
}

.tab-label-btn:hover {
    color: $accent;
}

.tab-close-btn {
    height: 1;
    min-width: 3;
    padding: 0 0;
    border: none;
    background: transparent;
    color: $foreground-muted;
}

.tab-close-btn:hover {
    color: $error;
    background: $panel;
}

#toggle-split-btn {
    width: auto;
    height: 1;
    min-width: 6;
    padding: 0 1;
    border: none;
    background: $surface;
    color: $accent;
    text-style: bold;
}

#editor-content-area {
    height: 1fr;
    padding: 0 0;
    background: $background;
    overflow-y: auto;
    overflow-x: auto;
}

#active-editor-view {
    width: 1fr;
    height: 1fr;
    min-height: 20;
    background: $background;
    color: $foreground;
    border: none;
}

#active-editor-view:focus {
    border: tall $accent;
}

.editor-view {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    background: $background;
    color: $foreground;
}

/* ── Tab Button Accessibility ─────────────────────────────────── */

.tab-item-active:focus,
.tab-item-inactive:focus {
    border: tall $accent;
    background: $surface;
}

.tab-item-active:hover,
.tab-item-inactive:hover {
    background: $surface;
    color: $accent;
}

.tab-item-active:disabled,
.tab-item-inactive:disabled {
    color: $foreground-muted;
    background: $panel;
}

.tab-close-btn:focus {
    border: tall $accent;
    background: $surface;
    color: $error;
}

.tab-close-btn:hover {
    color: $error;
    background: $panel;
}

.tab-close-btn:disabled {
    color: $foreground-muted;
    background: transparent;
}

#toggle-split-btn:focus {
    border: tall $accent;
    background: $surface;
}

#toggle-split-btn:hover {
    background: $surface;
    color: $accent;
}

#toggle-split-btn:disabled {
    color: $foreground-muted;
    background: $panel;
}

/* ── Responsive: Editor Split Pane ────────────────────────────── */

.narrow-terminal #editor-split-pane {
    display: none;
}

.very-narrow-terminal #editor-split-pane {
    display: none;
}

.short-terminal #editor-split-pane {
    width: 2fr;
}

#agent-split-pane {
    width: 2fr;
    height: 100%;
    background: $background;
}

#terminal-header-bar {
    height: 1;
    background: $panel;
    padding: 0 1;
    border-bottom: solid $primary;
}

#terminal-header-bar .panel-header-title {
    width: 1fr;
    height: 1;
    content-align: left middle;
    background: transparent;
    border-bottom: none;
}

#compact-btn, #help-btn {
    width: auto;
    height: 1;
    margin-left: 1;
    padding: 0 1;
    border: none;
    text-style: bold;
}

/* #compact-btn uses the built-in warning Button variant, which computes a
   theme-correct text color ($button-color-foreground) — no hardcoded hex. */

#attach-context-btn {
    width: 3;
    height: 3;
    min-width: 3;
    padding: 0;
    margin: 0;
    margin-right: 1;
    border: none;
    background: transparent;
    color: $primary;
    text-style: bold;
}

#attach-context-btn:hover {
    background: $surface;
    color: $accent;
}

#context-meter-bar {
    height: 1;
    min-height: 1;
    background: $surface;
    padding: 0 1;
    color: $foreground;
    text-style: bold;
    border-top: solid $panel;
}

/* ── Sidebar ──────────────────────────────────────────────────────────── */

.sidebar-section-title {
    text-style: bold;
    color: $primary;
    margin-top: 0;
    margin-bottom: 0;
    height: 1;
    content-align: left middle;
}

/* ── File Tree ────────────────────────────────────────────────────────── */

#file-tree {
    height: 1fr;
    background: $background;
    border: solid $panel;
    color: $foreground;
    margin-bottom: 1;
}

#file-tree:focus {
    border: tall $accent;
}

Tree {
    background: $background;
    color: $foreground;
}

Tree:hover {
    background: $surface;
}

Tree:focus {
    border: tall $accent;
}

/* ── Implementation Plan Panel ────────────────────────────────────────── */

#plan-panel {
    width: 100%;
    height: 1fr;
    background: $surface;
    padding: 1 1;
    color: $foreground;
    overflow-y: auto;
}

#plan-overview-collapsible, #task-checklist-collapsible {
    background: $surface;
    border: none;
    margin-bottom: 1;
}

#plan-overview-panel, #task-checklist-panel {
    background: $surface;
    padding: 0 1;
    color: $foreground;
    overflow-y: auto;
}

/* ── Chat Pane ────────────────────────────────────────────────────────── */

/* ── Input Base ───────────────────────────────────────────────────────── */

Input {
    color: $foreground !important;
    background: $background;
    border: solid $primary;
}

Input:focus {
    color: $foreground;
    background: $surface;
    border: tall $accent;
}

Input:disabled {
    border: solid $panel;
    color: $foreground-muted;
    background: $background;
}

Input > .input--value {
    color: $foreground;
}

Input > .input--placeholder {
    color: $foreground-muted;
    text-style: italic;
}

Input > .input--cursor {
    background: $primary;
    color: $background;
}

/* ── TextArea (user prompt input) ─────────────────────────────────────── */

TextArea {
    color: $foreground;
    background: $background;
    border: solid $primary;
}

TextArea:focus {
    color: $foreground;
    background: $surface;
    border: tall $accent;
}

TextArea:disabled {
    border: solid $panel;
    color: $foreground-muted;
    background: $background;
}

/* ── Status Bar ───────────────────────────────────────────────────────── */

#help-btn {
    width: auto;
    height: 1;
    min-width: 14;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $accent;
    text-style: bold;
}

#help-btn:hover {
    background: $panel;
    color: $primary;
}

#help-btn:focus {
    border: none;
    background: $panel;
    color: $primary;
}

/* ── Chat Container ───────────────────────────────────────────────────── */

#transcript-area {
    height: 1fr;
    width: 1fr;
}

#chat-container {
    width: 1fr;
    height: 100%;
    padding: 0 4;
    background: $background;
    color: $foreground;
}

#trajectory-rail {
    width: 4;
    height: 100%;
    background: $background;
    border-left: solid $panel;
}

/* ── Input Area ───────────────────────────────────────────────────────── */

#input-area {
    height: auto;
    min-height: 4;
    max-height: 8;
    background: $surface;
    border-top: solid $panel;
    padding: 0 1;
}

#input-row {
    height: auto;
    min-height: 3;
    max-height: 14;
    align: center middle;
}

#user-input {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 12;
    background: $background;
    color: $foreground;
    border: tall $primary;
}

#user-input:focus {
    background: $surface;
    border: tall $accent;
    color: $foreground;
}

/* Slash-command / @file autocomplete dropdown under the prompt */
#input-suggestions {
    display: none;
    height: auto;
    max-height: 6;
    margin-top: 1;
    background: $background;
    border: solid $panel;
}

#input-suggestions:focus {
    border: tall $accent;
}

#input-suggestions > ListItem {
    padding: 0 1;
}

#input-suggestions > ListItem.--highlight {
    background: $accent;
    color: $background;
    text-style: bold;
}

#input-suggestions > ListItem.--highlight:hover {
    background: $accent;
}

#send-btn {
    width: auto;
    min-width: 8;
    height: 3;
    margin: 0 0 0 1;
}

#send-btn:disabled {
    background: $surface;
    color: $foreground-muted;
}

#input-spinner {
    width: 3;
    height: 3;
    color: $primary;
    content-align: center middle;
}

.stream-text {
    color: $foreground;
    margin: 0 0 0 2;
}

/* ── Thinking blocks (Phase 1) ────────────────────────────────────────── */

.thinking-block {
    margin: 0 0 1 0;
    padding: 0;
}

.thinking-block-body {
    color: $foreground-muted;
    padding: 1 2;
    margin: 0;
}

/* ═══════════════════════════════════════════════════════════════════════════
   Responsive Design (classes toggled by Resize handler in Python)
   ═══════════════════════════════════════════════════════════════════════════ */

.very-narrow-terminal #input-area {
    height: auto;
    min-height: 4;
    max-height: 6;
}
.very-narrow-terminal #user-input {
    min-height: 3;
    max-height: 4;
}
.narrow-terminal #trajectory-rail {
    display: none;
}
.narrow-terminal #status-bar .sb-tps,
.narrow-terminal #status-bar .sb-errors {
    display: none;
}
.very-narrow-terminal #status-bar .sb-gauge {
    display: none;
}
.very-narrow-terminal #telemetry-bar {
    height: 1;
    min-height: 1;
}
.very-narrow-terminal #context-meter-bar {
    display: none;
}

/* ═══════════════════════════════════════════════════════════════════════════
   Modal Base Styles
   ═══════════════════════════════════════════════════════════════════════════ */

/* All modals share these base properties */
ModalScreen {
    background: $background 80%;
}

/* Shared dialog container for all modals */
#approval-dialog,
#picker-dialog,
#model-dialog,
#copy-dialog,
#status-dialog {
    background: $surface;
    border: heavy $primary;
    padding: 1 2;
}

/* Shared dialog titles */
#approval-title,
#picker-title,
#model-title,
#copy-title,
#status-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

/* Shared button bar layout */
#approval-buttons,
#picker-buttons,
#status-buttons {
    height: 3;
    align: center middle;
}

#approval-buttons Button,
#picker-buttons Button,
#status-buttons Button {
    margin: 0 2;
    min-width: 16;
}

#approval-buttons Button:hover,
#picker-buttons Button:hover,
#status-buttons Button:hover {
    text-style: bold;
}

#approval-buttons Button:focus,
#picker-buttons Button:focus,
#status-buttons Button:focus {
    outline: solid $accent;
}

/* Shared content areas */
#approval-args,
#picker-path,
#picker-tree,
#status-log-scroll {
    background: $background;
    border: solid $panel;
    padding: 1;
    color: $foreground;
}

/* Shared card styles */
.model-card,
.copy-item-card {
    background: $background;
    border: solid $panel;
    padding: 1;
    margin-bottom: 1;
}

.model-card:hover,
.copy-item-card:hover {
    border: solid $accent;
}

/* Approval modal - danger border */
#approval-dialog {
    border: heavy $error;
}

#approval-title {
    color: $error;
}

/* ── Collapsible & Tool Cards ─────────────────────────────────────────── */

Collapsible {
    background: $surface;
    border: solid $panel;
    margin: 0 0 1 0;
    padding: 0;
}

CollapsibleTitle {
    background: $panel;
    color: $foreground;
    padding: 0 1;
    height: 1;
}

CollapsibleTitle:hover {
    background: $block-hover-background;
}

CollapsibleContents {
    padding: 0;
    margin: 0;
    background: $background;
}

/* ═══════════════════════════════════════════════════════════════════════════
   CMD_CENTER_V1.0 Cyberpunk Styles
   ═══════════════════════════════════════════════════════════════════════════ */

#top-hud-header {
    dock: top;
    height: 1;
    background: $surface;
    border-bottom: solid $primary;
    padding: 0 1;
}

#hud-title {
    width: auto;
    color: $primary;
    text-style: bold;
    margin-right: 2;
}

.hud-badge {
    width: auto;
    padding: 0 1;
    background: $panel;
    color: $primary;
    margin-right: 1;
}

.hud-badge-green {
    width: auto;
    padding: 0 1;
    background: $primary;
    color: $background;
    text-style: bold;
    margin-right: 1;
}

#hud-spacer {
    width: 1fr;
}

.mode-badge-goal {
    width: auto;
    height: 1;
    padding: 0 1;
    border: none;
    background: $primary;
    color: $background;
    text-style: bold;
    margin-right: 1;
}

.mode-badge-chat {
    width: auto;
    height: 1;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $primary;
    text-style: bold;
    margin-right: 1;
}

/* Approval modal buttons */
.btn-gold {
    background: $warning;
    color: $background;
    text-style: bold;
    border: none;
    margin-right: 1;
}

.btn-outline {
    background: transparent;
    color: $warning;
    border: solid $warning;
}

/* Telemetry & Gauges */
#telemetry-bar {
    height: 1;
    min-height: 1;
    background: $surface;
    border-top: none;
    padding: 0 1;
}

/* ── context-meter-bar removed in UX v2 (telemetry-bar height now = 1) ── */


/* Bottom Nav Dock */
#bottom-nav-dock {
    height: 1;
    background: $panel;
    border-top: solid $primary;
    align: center middle;
}

.nav-dock-btn {
    width: auto;
    height: 1;
    min-height: 1;
    min-width: 14;
    padding: 0 2;
    margin: 0 1;
    border: none;
    background: transparent;
    color: $primary;
    text-style: bold;
}

.nav-dock-btn:hover {
    background: $surface;
    color: $accent;
}

.nav-dock-btn-active {
    width: auto;
    height: 1;
    min-height: 1;
    min-width: 14;
    padding: 0 2;
    margin: 0 1;
    border: none;
    background: $primary;
    color: $background;
    text-style: bold;
}



/* Context Chips */
#context-chips-bar {
    height: auto;
    max-height: 3;
    padding-left: 1;
    margin-bottom: 1;
    display: none;
}

#context-chips-bar.has-chips {
    display: block;
}

.context-chip {
    height: 1;
    min-width: 5;
    padding: 0 1;
    margin-right: 1;
    background: $accent 30%;
    color: $text;
    border: none;
}

.context-chip:hover {
    background: $error;
    color: $text;
}


/* ═══════════════════════════════════════════════════════════════════════════
   UX Overhaul v2 — New widget styles
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── ConnectionPill ───────────────────────────────────────────────────── */

ConnectionPill {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    border: none;
    text-style: bold;
    background: transparent;
}

ConnectionPill.connected {
    color: $success;
}

ConnectionPill.disconnected {
    color: $foreground-muted;
}

/* ── CenterEmptyState ─────────────────────────────────────────────────── */

CenterEmptyState {
    width: 1fr;
    height: 1fr;
    background: $background;
    align: center middle;
    content-align: center middle;
    padding: 2 4;
}

CenterEmptyState .empty-state-title {
    text-style: bold;
    color: $primary;
    width: auto;
    margin-bottom: 1;
    content-align: center middle;
}

CenterEmptyState .empty-state-subtitle {
    color: $foreground-muted;
    width: auto;
    content-align: center middle;
}

CenterEmptyState .empty-state-hint {
    color: $foreground-muted;
    text-style: italic;
    width: auto;
    margin-top: 1;
    content-align: center middle;
}

/* ── Disabled SEND button ─────────────────────────────────────────────── */

#send-btn:disabled {
    color: $foreground-muted;
    background: $panel;
    border: solid $panel;
    opacity: 0.5;
}

/* ── Agent tab section titles (right sidebar) ─────────────────────────── */

.sidebar-section-title {
    text-style: bold;
    color: $primary;
    margin-top: 1;
    margin-bottom: 0;
    height: 1;
    padding: 0 1;
    content-align: left middle;
    border-bottom: solid $panel;
}

/* ── Output tab log content ───────────────────────────────────────────── */

#output-log-content {
    width: 100%;
    padding: 0 1;
    color: $foreground;
}

/* ── Agent tab subwidgets ─────────────────────────────────────────────── */

#agent-tab-conn-status, #agent-tab-model-info, #agent-tab-context-bar {
    padding: 0 1 1 1;
    width: 100%;
    color: $foreground;
}
